---
import '@/styles/tokens.css';
import '@/styles/reset.css';
import '@/styles/global.css';

import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import SeoHead from '@/components/seo/SeoHead.astro';
import { site } from '@/config/site';
import { getLocale, languageTags } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';
import type { RouteKey } from '@/i18n/routes';

interface Props {
  routeKey: RouteKey;
  /** Overrides the default page title (the navigation label). */
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
}

const { routeKey, title, description, image, imageAlt, noindex } = Astro.props;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const pageTitle = title ?? (routeKey === 'home' ? undefined : t(`nav.${routeKey}`));
const documentTitle = pageTitle ? `${pageTitle}${site.titleSeparator}${site.name}` : site.name;
---

<!doctype html>
<!--
  One-page website: every section lives on this page and the navigation scrolls
  to it through native anchor links (smooth scrolling is set in global.css).
-->
<html lang={languageTags[locale]}>
  <head>
    <SeoHead
      title={documentTitle}
      locale={locale}
      routeKey={routeKey}
      description={description}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
    />
    <Font cssVariable="--font-montserrat" preload={[{ subset: 'latin', weight: '400' }]} />
    <!-- Declared on every page; font files download only where they are used. -->
    <Font cssVariable="--font-tenor" />
    <Font cssVariable="--font-source-serif" />
  </head>
  <body>
    <!-- Markers observed by the header (background) and navigation (active link). -->
    <div class="page-marker page-marker--top" data-page-top aria-hidden="true"></div>

    <a class="skip-link" href="#main-content">{t('skipLink')}</a>

    <Header locale={locale} currentRoute={routeKey} />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <div class="page-marker" data-page-end aria-hidden="true"></div>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    z-index: 100;
    inset-block-start: 0;
    inset-inline-start: 0;
    padding: var(--space-xs) var(--space-md);
    background-color: var(--color-background);
    font-size: var(--text-sm);
    transform: translateY(-100%);
  }

  .skip-link:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  .page-marker {
    height: 1px;
  }

  /* Out of the flow, so the hero still starts at the very top. */
  .page-marker--top {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 0.5rem;
    pointer-events: none;
  }
</style>
