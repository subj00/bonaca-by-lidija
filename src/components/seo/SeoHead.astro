---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { locales, ogLocales, type Locale } from '@/i18n/config';
import { getAlternateLinks, getPath, type RouteKey } from '@/i18n/routes';
import { site } from '@/config/site';

export interface Props {
  title: string;
  locale: Locale;
  routeKey: RouteKey;
  description?: string | undefined;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  noindex?: boolean | undefined;
}

const { title, locale, routeKey, description, image, imageAlt, noindex = false } = Astro.props;

const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(getPath(routeKey, locale), siteUrl).href;
const alternateLinks = getAlternateLinks(routeKey, siteUrl);
const alternateOgLocales = locales
  .filter((item) => item !== locale)
  .map((item) => ogLocales[item]);

const ogImage = image ? await getImage({ src: image, format: 'jpg' }) : undefined;
const ogImageUrl = ogImage ? new URL(ogImage.src, siteUrl).href : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalUrl} />
{alternateLinks.map(({ hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={href} />
))}
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={ogLocales[locale]} />
{alternateOgLocales.map((item) => <meta property="og:locale:alternate" content={item} />)}
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{ogImageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
