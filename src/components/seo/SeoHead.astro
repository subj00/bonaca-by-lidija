---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { locales, ogLocales, type Locale } from '@/i18n/config';
import { getAlternateLinks, getPath, type RouteKey } from '@/i18n/routes';
import { site } from '@/config/site';
import { studioSeoLocation } from '@/data/contact';
import StructuredData from '@/components/seo/StructuredData.astro';

export interface Props {
  title: string;
  locale: Locale;
  routeKey: RouteKey;
  description?: string | undefined;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  noindex?: boolean | undefined;
}

const { title, locale, routeKey, description, image, imageAlt, noindex = false } = Astro.props;

const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(getPath(routeKey, locale), siteUrl).href;
const alternateLinks = getAlternateLinks(routeKey, siteUrl);
const alternateOgLocales = locales
  .filter((item) => item !== locale)
  .map((item) => ogLocales[item]);

// Link previews: a 1200px-wide JPEG (widely supported by social platforms).
const ogImage = image
  ? await getImage({ src: image, format: 'jpg', width: Math.min(1200, image.width), quality: 85 })
  : undefined;
const ogImageUrl = ogImage ? new URL(ogImage.src, siteUrl).href : undefined;
const ogImageWidth = ogImage?.attributes.width;
const ogImageHeight = ogImage?.attributes.height;

/*
 * Google Search Console ownership check (HTML tag method). Set
 * PUBLIC_GOOGLE_SITE_VERIFICATION in the hosting environment (or .env) to the
 * token Search Console shows; nothing is output while it is empty.
 */
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

/** Favicon file version (the "B" monogram). */
const faviconVersion = 2;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
<meta name="generator" content={Astro.generator} />

{/*
  Favicons (public/), generated from src/assets/favicon/bonaca-favicon.png.
  Raise faviconVersion whenever the icon changes, so browsers fetch the new
  files instead of a cached copy.
*/}
<link rel="icon" href={`/favicon.ico?v=${faviconVersion}`} sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" href={`/favicon-32x32.png?v=${faviconVersion}`} sizes="32x32" />
<link rel="icon" type="image/png" href={`/favicon-192x192.png?v=${faviconVersion}`} sizes="192x192" />
<link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${faviconVersion}`} sizes="180x180" />

<link rel="canonical" href={canonicalUrl} />
{alternateLinks.map(({ hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={href} />
))}
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={ogLocales[locale]} />
{alternateOgLocales.map((item) => <meta property="og:locale:alternate" content={item} />)}
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
{ogImageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
{ogImageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

{/* Studio location for local search (no coordinates until the studio confirms them). */}
<meta name="geo.region" content={studioSeoLocation.regionCode} />
<meta
  name="geo.placename"
  content={`${studioSeoLocation.municipality}, ${studioSeoLocation.city}`}
/>

{googleVerification &&<meta name="google-site-verification" content={googleVerification} />}

{routeKey === 'home' && description && (
  <StructuredData locale={locale} description={description} imageUrl={ogImageUrl} />
)}
