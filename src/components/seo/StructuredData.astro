---
import { getImage } from 'astro:assets';
import heroPhoto from '@/assets/images/home/home-page.png';
import logo from '@/assets/logos/bonaca-logo.png';
import { languageTags, locales, type Locale } from '@/i18n/config';
import { site } from '@/config/site';
import { contactPeople, studioMapUrl, studioSeoLocation as location } from '@/data/contact';
import { educationArtists } from '@/data/educations';
import { anaService, lidijaService } from '@/data/serviceDetails';
import { getPath, serviceAnchors } from '@/i18n/routes';

interface Props {
  locale: Locale;
  /** Document title of the page (WebPage name). */
  title: string;
  /** Page description, reused for the business. */
  description: string;
}

type Localized = Record<Locale, string>;

const { locale, title, description } = Astro.props;

/*
 * JSON-LD (schema.org) for the home page, built only from content that is on
 * the page: the studio, its two artists, their services and the four courses.
 * The full postal address (data/contact.ts, studioSeoLocation) is used here
 * only, not on the page. A few facts confirmed by the studio are added as well:
 * on-location makeup is also available outside Belgrade, and every course is
 * held in person at the studio, in Serbian or English, by arrangement.
 * Deliberately left out: coordinates, opening hours, phone (never published),
 * prices that are not on the page (only Ana's 100 € is), ratings, and any
 * biography or qualification that is not on the page.
 * The four courses are also listed in an ItemList, the markup Google reads for
 * its course list (carousel) result.
 */
const siteUrl = Astro.site ?? Astro.url;
const pageUrl = new URL(getPath('home', locale), siteUrl).href;
const anchor = (id: string) => `${pageUrl}#${id}`;
const rootUrl = new URL('/', siteUrl).href;

const studioId = `${rootUrl}#studio`;
const websiteId = `${rootUrl}#website`;
const webPageId = `${pageUrl}#webpage`;

// Brand logo for search results: the dark wordmark as a 600px-wide PNG.
const logoImage = await getImage({ src: logo, format: 'png', width: 600 });
const logoObject = {
  '@type': 'ImageObject',
  '@id': `${rootUrl}#logo`,
  url: new URL(logoImage.src, siteUrl).href,
  width: logoImage.attributes.width,
  height: logoImage.attributes.height,
  caption: site.name,
};
// The studio photograph (hero), for the business and the page.
const heroImage = await getImage({ src: heroPhoto, format: 'jpg', width: 1200, quality: 85 });
const heroImageUrl = new URL(heroImage.src, siteUrl).href;

const cityId = `${rootUrl}#city`;
const [lidijaContact, anaContact] = contactPeople;
const people = [
  { id: `${rootUrl}#lidija`, contact: lidijaContact },
  { id: `${rootUrl}#ana`, contact: anaContact },
];
const lidijaId = people[0].id;
const anaId = people[1].id;

/*
 * On-location makeup (shown on the page as "Mogućnost izlaska na teren"). The
 * studio confirmed it is available in Belgrade and in other cities as well, so
 * no areaServed is set: listing only Belgrade would be wrong, and the other
 * cities have not been named.
 */
const onLocation: { name: Localized; description: Localized } = {
  name: { sr: 'Šminkanje na terenu', en: 'On-location makeup' },
  description: {
    sr: 'Šminkanje na terenu, u Beogradu i u drugim gradovima, po dogovoru.',
    en: 'On-location makeup in Belgrade and in other cities, by arrangement.',
  },
};

const services = [
  {
    name: lidijaService.title[locale],
    description: lidijaService.description[locale].join(' '),
    provider: lidijaId,
    url: anchor(serviceAnchors.lidija),
  },
  {
    name: onLocation.name[locale],
    description: onLocation.description[locale],
    provider: lidijaId,
    url: anchor(serviceAnchors.lidija),
  },
  ...anaService.treatments.map((treatment) => ({
    name: treatment.title[locale],
    description: treatment.description[locale],
    provider: anaId,
    url: anchor(treatment.id === 'makeup' ? serviceAnchors.ana : serviceAnchors.lashBrowLift),
  })),
];

const providerByArtist: Record<string, string> = { lidija: lidijaId, ana: anaId };

/*
 * Course facts for search engines, taken from the course texts on the page
 * (duration, who it is for, the certificate). Nothing is added that the page
 * does not say.
 */
const certificateText: Localized = {
  sr: 'Sertifikat o završenoj edukaciji',
  en: 'Certificate of completion',
};
const beginner: Localized = { sr: 'Početni nivo', en: 'Beginner' };
const courseFacts: Record<
  string,
  { duration?: string; level?: Localized; prerequisites?: Localized; certificate?: boolean }
> = {
  'master-the-basics': { duration: 'P2M', level: beginner, certificate: true },
  'express-makeup-artistry': {
    duration: 'P2W',
    prerequisites: { sr: 'Predznanje iz šminkanja', en: 'Prior makeup experience' },
    certificate: true,
  },
  'makeup-artist-upgrade': {
    duration: 'P1D',
    prerequisites: {
      sr: 'Iskustvo u profesionalnom šminkanju',
      en: 'Professional makeup experience',
    },
  },
  'nasminkaj-se-sama': { level: beginner },
};

// Confirmed by the studio: the courses are taught in Serbian or English.
const courseLanguages = [languageTags.sr, languageTags.en];

const courses = educationArtists.flatMap((artist) =>
  artist.courses.map((course) => {
    const facts = courseFacts[course.id] ?? {};
    const instructor = { '@id': providerByArtist[artist.id] };
    return {
      '@type': 'Course',
      '@id': anchor(course.id),
      url: anchor(course.id),
      name: course.title[locale],
      description: [course.subtitle[locale], ...course.description.map((p) => p[locale])].join(' '),
      inLanguage: languageTags[locale],
      availableLanguage: courseLanguages,
      // Offered by the studio; the course is the artist's own program.
      provider: { '@id': studioId, name: site.name, url: rootUrl },
      creator: instructor,
      ...(facts.level && { educationalLevel: facts.level[locale] }),
      ...(facts.prerequisites && { coursePrerequisites: facts.prerequisites[locale] }),
      ...(facts.certificate && { educationalCredentialAwarded: certificateText[locale] }),
      // Held in person at the studio; dates are arranged with each student.
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'Onsite',
        location: { '@id': studioId },
        instructor,
        ...(facts.duration && { duration: facts.duration }),
      },
      ...(course.price && {
        offers: {
          '@type': 'Offer',
          category: 'Paid',
          price: course.price.value.replace(/[^\d.,]/g, '').replace(',', '.'),
          priceCurrency: 'EUR',
          url: anchor(course.id),
        },
      }),
    };
  }),
);

// Course list (carousel) markup: every course with its own URL (page anchor).
const courseList = {
  '@type': 'ItemList',
  '@id': `${pageUrl}#kursevi`,
  name: locale === 'sr' ? 'Kursevi šminkanja' : 'Makeup courses',
  itemListElement: courses.map((course, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: course.url,
    item: course,
  })),
};

// Topics each artist works in, as named on the page.
const knowsAbout: Record<string, string[]> = {
  [lidijaId]: [
    lidijaService.title[locale],
    onLocation.name[locale],
    locale === 'sr' ? 'Kursevi šminkanja' : 'Makeup courses',
  ],
  [anaId]: anaService.treatments.map((treatment) => treatment.title[locale]),
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: rootUrl,
      name: site.name,
      alternateName: site.businessName,
      inLanguage: locales.map((item) => languageTags[item]),
      publisher: { '@id': studioId },
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: pageUrl,
      name: title,
      description,
      inLanguage: languageTags[locale],
      isPartOf: { '@id': websiteId },
      about: { '@id': studioId },
      primaryImageOfPage: { '@type': 'ImageObject', url: heroImageUrl },
      mainEntity: { '@id': studioId },
    },
    {
      '@type': 'BeautySalon',
      '@id': studioId,
      // Same name as on the Google Business Profile.
      name: site.name,
      alternateName: site.businessName,
      url: rootUrl,
      logo: logoObject,
      description,
      image: heroImageUrl,
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${location.street}, ${location.neighborhood}`,
        addressLocality: location.municipality,
        addressRegion: location.city,
        postalCode: location.postalCode,
        addressCountry: location.countryCode,
      },
      hasMap: studioMapUrl,
      // The neighbourhood and the wider city the studio serves (not addresses).
      areaServed: [
        {
          '@type': 'Place',
          name: `${location.neighborhood}, ${location.municipality}`,
        },
        {
          '@type': 'AdministrativeArea',
          name: location.municipality,
          containedInPlace: { '@id': cityId },
        },
        {
          '@type': 'City',
          '@id': cityId,
          name: location.city,
          // The city's general postal code (11000 Beograd), as a reference only.
          address: {
            '@type': 'PostalAddress',
            addressLocality: location.city,
            postalCode: location.cityPostalCode,
            addressCountry: location.countryCode,
          },
          containedInPlace: { '@type': 'Country', name: 'Srbija', identifier: location.countryCode },
        },
      ],
      // The studio's Google Business Profile. The Instagram profiles belong to the artists (below).
      sameAs: [studioMapUrl],
      employee: people.map((person) => ({ '@id': person.id })),
      makesOffer: services.map((service) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: service.name,
          description: service.description,
          url: service.url,
          provider: { '@id': service.provider },
        },
      })),
    },
    ...people.map(({ id, contact }) => ({
      '@type': 'Person',
      '@id': id,
      name: contact.name,
      email: contact.email,
      sameAs: [contact.instagram.url],
      worksFor: { '@id': studioId },
      knowsAbout: knowsAbout[id],
    })),
    courseList,
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
