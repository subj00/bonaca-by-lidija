---
interface Props {
  name: string;
  /** Review text in the language of the current page. */
  text: string;
  /** Card background: light Linen or a soft Dusty Rose tint. */
  tone?: 'light' | 'rose';
}

const { name, text, tone = 'light' } = Astro.props;
---

<figure class:list={['review-card', { 'review-card--rose': tone === 'rose' }]}>
  <blockquote class="review-card__quote">
    <p>{text}</p>
  </blockquote>
  <figcaption class="review-card__name">{name}</figcaption>
</figure>

<style>
  .review-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: var(--space-lg) clamp(1.125rem, 5vw, 1.5rem) var(--space-xl);
    border-radius: var(--radius-card);
    background-color: var(--color-card);
    box-shadow: 0 1px 2px var(--color-shadow-soft);
    color: var(--color-ink);
  }

  .review-card--rose {
    background-color: var(--color-card-alt);
  }

  /*
   * Clean upright serif. Left-aligned on phones and tablets: their narrow
   * lines (about 35–45 characters) would get very wide word gaps if justified.
   */
  .review-card__quote {
    margin: 0;
    font-family: var(--font-reading);
    /* 16px on the narrowest phones, up to 17px; 16px on desktop. */
    font-size: clamp(1rem, 0.875rem + 0.6vw, 1.0625rem);
    font-style: normal;
    font-weight: 400;
    line-height: 1.7;
    text-align: start;
  }

  /* Short divider above the name, pinned to the bottom of the card. */
  .review-card__name {
    margin-block-start: auto;
    padding-block-start: var(--space-xl);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-smoky-rose);
  }

  .review-card__name::before {
    content: '';
    display: block;
    width: 1.75rem;
    height: 1px;
    margin-block-end: var(--space-md);
    background-color: var(--color-ink);
  }

  /* Desktop: compact editorial card (24–30px vertical, 28–36px horizontal padding). */
  @media (min-width: 64rem) {
    .review-card {
      padding: clamp(1.375rem, 2.8svh, 1.875rem) clamp(1.75rem, 2.4vw, 2.25rem);
    }

    /*
     * Justified on desktop, where lines are long enough for even word spacing.
     * Hyphenation (where the browser supports it) follows the page language
     * set on <html> (`sr-Latn` or `en`).
     */
    .review-card__quote {
      font-size: 1rem;
      line-height: 1.55;
      text-align: justify;
      text-justify: inter-word;
      -webkit-hyphens: auto;
      hyphens: auto;
      hyphenate-limit-chars: 7 3 3;
    }

    .review-card__name {
      padding-block-start: var(--space-sm);
      font-size: var(--text-2xs);
    }

    .review-card__name::before {
      width: 1.5rem;
      margin-block-end: var(--space-xs);
    }
  }
</style>
