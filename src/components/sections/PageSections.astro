---
import ContactSection from '@/components/contact/ContactSection.astro';
import EducationsSection from '@/components/education/EducationsSection.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import SectionPlaceholder from '@/components/sections/SectionPlaceholder.astro';
import ServicesSection from '@/components/services/ServicesSection.astro';
import { getLocale } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';
import { sections } from '@/i18n/routes';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<!-- All sections of the one-page website, in navigation order. -->
<HomeHero />
{/* About (O nama) is hidden for now. To restore it, put this back and add 'about' to navigationItems:
<SectionPlaceholder id={sections.about} title={t('nav.about')} /> */}
<ServicesSection />
<EducationsSection />
<ContactSection />
