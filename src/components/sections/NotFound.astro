---
import PillLink from '@/components/ui/PillLink.astro';
import { getLocale } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';
import { getPath } from '@/i18n/routes';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<!--
  "Page not found": the section heading style of the site (Tenor Sans, Smoky
  Rose, uppercase, divider), a short line and a link back to the home page.
-->
<section class="not-found" aria-labelledby="not-found-title">
  <p class="not-found__code" aria-hidden="true">404</p>
  <h1 class="not-found__title" id="not-found-title">{t('notFound.title')}</h1>
  <span class="section-divider not-found__rule" aria-hidden="true"></span>
  <p class="not-found__text">{t('notFound.text')}</p>
  <PillLink href={getPath('home', locale)}>{t('notFound.home')}</PillLink>
</section>

<style>
  /* Fills the first screen below the fixed header, so the footer stays below it. */
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 100svh;
    padding: calc(var(--header-height-mobile) + var(--space-2xl)) var(--content-inset)
      var(--space-2xl);
    text-align: center;
  }

  .not-found__code {
    color: var(--color-dusty-rose);
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 18vw, 6rem);
    line-height: 1;
    letter-spacing: 0.16em;
    padding-inline-start: 0.16em;
  }

  /* Same as the section headings (SectionTitle.astro). */
  .not-found__title {
    margin-block-start: var(--space-lg);
    color: var(--color-smoky-rose);
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 7.2vw, 2.25rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0.16em;
    padding-inline-start: 0.16em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .not-found__rule {
    margin-block-start: var(--space-lg);
  }

  .not-found__text {
    max-width: 32rem;
    margin-block: var(--space-lg) var(--space-xl);
    color: var(--color-text-body);
    font-size: 0.9375rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  @media (min-width: 64rem) {
    .not-found {
      padding-block-start: calc(var(--header-height-desktop) + var(--space-2xl));
    }

    .not-found__title {
      font-size: clamp(2.25rem, 2.6vw, 2.625rem);
      letter-spacing: 0.14em;
      padding-inline-start: 0.14em;
    }

    .not-found__rule {
      margin-block-start: var(--space-md);
    }
  }
</style>
