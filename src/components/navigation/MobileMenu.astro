---
import { Image } from 'astro:assets';
import studioPhoto from '@/assets/images/home/studio.jpeg';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const panelId = 'site-menu';
---

<!--
  Wraps the navigation and language switcher once, so their markup is never duplicated.
  Mobile: a full-screen panel toggled by one button whose hamburger icon morphs into an X.
  Desktop (≥ 64rem): the wrappers use `display: contents` and the header lays out the links.
  Without JavaScript the panel is rendered as a plain, always-visible list.
-->
<div class="mobile-menu" data-mobile-menu data-open="false">
  <button
    class="mobile-menu__toggle"
    type="button"
    aria-controls={panelId}
    aria-expanded="false"
    aria-label={t('menu.open')}
    data-menu-toggle
    data-label-open={t('menu.open')}
    data-label-close={t('menu.close')}
  >
    <span class="mobile-menu__icon" aria-hidden="true">
      <span class="mobile-menu__line"></span>
      <span class="mobile-menu__line"></span>
      <span class="mobile-menu__line"></span>
    </span>
  </button>

  <div class="mobile-menu__panel" id={panelId} data-menu-panel>
    <!--
      Decorative studio photograph behind the links (mobile only), muted by a
      Linen overlay. Small responsive WebP versions are generated from the JPEG;
      `display: none` on desktop means it is never downloaded there.
    -->
    <Image
      class="mobile-menu__backdrop"
      src={studioPhoto}
      alt=""
      width={960}
      widths={[480, 720, 960]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
    />

    <div class="mobile-menu__content">
      <slot />
    </div>
  </div>
</div>

<script>
  const DESKTOP_QUERY = window.matchMedia('(min-width: 64rem)');

  function getMenu() {
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const toggle = menu?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = menu?.querySelector<HTMLElement>('[data-menu-panel]');
    return menu && toggle && panel ? { menu, toggle, panel } : undefined;
  }

  function isOpen(menu: HTMLElement) {
    return menu.dataset.open === 'true';
  }

  function setOpen(open: boolean) {
    const elements = getMenu();
    if (!elements) return;
    const { menu, toggle } = elements;

    menu.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute(
      'aria-label',
      (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '',
    );
  }

  /** Keeps keyboard focus inside the open menu (toggle button + links). */
  function trapFocus(event: KeyboardEvent, toggle: HTMLElement, panel: HTMLElement) {
    const focusable = [toggle, ...panel.querySelectorAll<HTMLElement>('a[href]')];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }

  /*
   * Binds the toggle and the links once, when the page loads.
   */
  function initMobileMenu() {
    const elements = getMenu();
    if (!elements) return;
    const { menu, toggle, panel } = elements;

    toggle.addEventListener('click', () => setOpen(!isOpen(menu)));

    /*
     * Selecting a link closes the menu (the X animates back into the hamburger)
     * and releases the scroll lock synchronously, so the browser's native anchor
     * navigation then smoothly scrolls to the section and updates the URL hash.
     */
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
  }

  initMobileMenu();

  document.addEventListener('keydown', (event) => {
    const elements = getMenu();
    if (!elements || !isOpen(elements.menu) || DESKTOP_QUERY.matches) return;

    if (event.key === 'Escape') {
      setOpen(false);
      elements.toggle.focus();
    } else if (event.key === 'Tab') {
      trapFocus(event, elements.toggle, elements.panel);
    }
  });

  // Reset the menu if the viewport grows to the desktop layout while it is open.
  DESKTOP_QUERY.addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>

<style>
  /*
   * Sits in the header row; the negative margin keeps the 44px tap target
   * without making the row taller.
   */
  .mobile-menu__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    /* Aligns the visible icon (1.625rem wide) with the header padding edge. */
    margin-block: calc(var(--space-sm) * -1);
    margin-inline: calc((2.75rem - 1.625rem) / -2);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  /* Hamburger icon: three thin lines that morph into a symmetrical X. */
  .mobile-menu__icon {
    position: relative;
    width: 1.625rem;
    height: 1.125rem;
  }

  .mobile-menu__line {
    --line-weight: 1.25px;

    position: absolute;
    inset-inline: 0;
    height: var(--line-weight);
    background-color: currentColor;
    transition:
      translate var(--duration-menu-icon) var(--ease-out),
      rotate var(--duration-menu-icon) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .mobile-menu__line:nth-child(1) {
    inset-block-start: 0;
  }

  .mobile-menu__line:nth-child(2) {
    inset-block-start: calc(50% - var(--line-weight) / 2);
  }

  .mobile-menu__line:nth-child(3) {
    inset-block-end: 0;
  }

  [data-open='true'] .mobile-menu__line:nth-child(1) {
    translate: 0 calc(0.5625rem - var(--line-weight) / 2);
    rotate: 45deg;
  }

  [data-open='true'] .mobile-menu__line:nth-child(2) {
    opacity: 0;
  }

  [data-open='true'] .mobile-menu__line:nth-child(3) {
    translate: 0 calc(-0.5625rem + var(--line-weight) / 2);
    rotate: -45deg;
  }

  /*
   * Full-screen panel painted *behind* the header's own content: the header is
   * the stacking context (z-index 10 over the page), and z-index −1 places the
   * panel under its logo and toggle while still above the page. The header
   * therefore stays visible and stationary; only the panel animates.
   * The top padding keeps the links below the header row.
   */
  .mobile-menu__panel {
    position: fixed;
    z-index: -1;
    inset: 0;
    display: grid;
    place-items: center;
    padding: calc(var(--header-height-mobile) + var(--space-lg)) var(--frame-padding-inline)
      var(--space-2xl);
    background-color: var(--color-background);
    overflow-y: auto;
  }

  /*
   * Studio photograph, cropped towards the illuminated mirror and makeup
   * stations, lightly desaturated and muted by a Linen overlay.
   */
  .mobile-menu__backdrop {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
    filter: saturate(0.7);
  }

  .mobile-menu__panel::after {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 0;
    background-color: color-mix(
      in srgb,
      var(--color-linen) var(--menu-overlay-strength),
      transparent
    );
  }

  .mobile-menu__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
  }

  /*
   * Closed by default; opens with a soft fade and a small slide down.
   * Opening and closing use their own durations (set on the target state).
   */
  @media (scripting: enabled) {
    .mobile-menu__panel {
      visibility: hidden;
      opacity: 0;
      translate: 0 -0.75rem;
      transition:
        opacity var(--duration-menu-close) var(--ease-out),
        translate var(--duration-menu-close) var(--ease-out),
        visibility 0s linear var(--duration-menu-close);
    }

    [data-open='true'] .mobile-menu__panel {
      visibility: visible;
      opacity: 1;
      translate: 0 0;
      transition:
        opacity var(--duration-menu-open) var(--ease-out),
        translate var(--duration-menu-open) var(--ease-out),
        visibility 0s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu__panel,
    [data-open='true'] .mobile-menu__panel,
    .mobile-menu__line {
      transition: none;
    }
  }

  /* Without JavaScript the links are shown as a plain list below the logo. */
  @media (scripting: none) {
    .mobile-menu {
      flex-basis: 100%;
    }

    .mobile-menu__toggle {
      display: none;
    }

    .mobile-menu__panel {
      position: static;
      padding-block: var(--space-xl) 0;
      background: none;
    }

    .mobile-menu__backdrop,
    .mobile-menu__panel::after {
      display: none;
    }
  }

  /* Prevent background scrolling while the mobile menu is open. */
  @media (width < 64rem) {
    :global(html:has(.mobile-menu[data-open='true'])) {
      overflow: hidden;
    }
  }

  @media (min-width: 64rem) {
    .mobile-menu__toggle,
    .mobile-menu__backdrop,
    .mobile-menu__panel::after {
      display: none;
    }

    /* Let the parent header lay out the navigation and language switcher directly. */
    .mobile-menu,
    .mobile-menu__panel,
    .mobile-menu__content {
      display: contents;
    }

    .mobile-menu__panel,
    [data-open='true'] .mobile-menu__panel {
      visibility: visible;
      opacity: 1;
      translate: none;
      transition: none;
    }
  }
</style>
