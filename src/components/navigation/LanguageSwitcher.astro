---
import { languageNames, languageTags, locales, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';
import { getPath, type RouteKey } from '@/i18n/routes';

interface Props {
  locale: Locale;
  currentRoute: RouteKey;
}

const { locale, currentRoute } = Astro.props;
const t = useTranslations(locale);
---

<nav class="language-switcher" aria-label={t('languageSwitcher.label')}>
  <ul class="language-switcher__list" role="list">
    {locales.map((item) => (
      <li class="language-switcher__item">
        <a
          class="language-switcher__link"
          href={getPath(currentRoute, item)}
          data-language-base={getPath(currentRoute, item)}
          hreflang={languageTags[item]}
          lang={languageTags[item]}
          aria-label={languageNames[item]}
          aria-current={item === locale ? 'true' : undefined}
        >
          {item.toUpperCase()}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  import { SECTION_CHANGE_EVENT, sections } from '@/i18n/routes';

  /*
   * Keeps the reader's place when switching language: the links always point to
   * the section currently in view (e.g. `/#recenzije` ↔ `/en#recenzije`), whether
   * it was reached through the navigation or by scrolling. The active section
   * comes from the navigation's existing IntersectionObserver.
   */
  const languageLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-language-base]')];

  document.addEventListener(SECTION_CHANGE_EVENT, (event) => {
    const sectionId = (event as CustomEvent<string>).detail;
    const hash = sectionId && sectionId !== sections.home ? `#${sectionId}` : '';

    languageLinks.forEach((link) => {
      link.setAttribute('href', `${link.dataset.languageBase}${hash}`);
    });
  });
</script>

<style>
  .language-switcher__list {
    display: flex;
    align-items: center;
  }

  .language-switcher__item + .language-switcher__item::before {
    /* Visual separator only; hidden from assistive technology. */
    content: '|' / '';
    padding-inline: 0.6em;
    font-weight: 400;
  }

  .language-switcher__item {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
  }

  .language-switcher__link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.5em;
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .language-switcher__link:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 64rem) {
    .language-switcher__item {
      font-size: var(--text-xs);
      line-height: 1.75;
    }
  }
</style>
