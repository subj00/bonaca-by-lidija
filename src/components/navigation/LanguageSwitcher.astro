---
import { languageNames, languageTags, locales, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';
import { getPath, type RouteKey } from '@/i18n/routes';

interface Props {
  locale: Locale;
  currentRoute: RouteKey;
}

const { locale, currentRoute } = Astro.props;
const t = useTranslations(locale);
---

<nav class="language-switcher" aria-label={t('languageSwitcher.label')}>
  <ul class="language-switcher__list" role="list">
    {locales.map((item) => (
      <li class="language-switcher__item">
        <a
          class="language-switcher__link"
          href={getPath(currentRoute, item)}
          data-language-base={getPath(currentRoute, item)}
          hreflang={languageTags[item]}
          lang={languageTags[item]}
          // Starts with the visible code (SR / EN), so speech commands match the label.
          aria-label={`${item.toUpperCase()}, ${languageNames[item]}`}
          aria-current={item === locale ? 'true' : undefined}
        >
          {item.toUpperCase()}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  import { SECTION_CHANGE_EVENT, sections } from '@/i18n/routes';

  /*
   * Keeps the reader's place when switching language: the links always point to
   * the section currently in view (e.g. `/#usluge` ↔ `/en/#usluge`), whether
   * it was reached through the navigation or by scrolling. The active section
   * comes from the navigation's existing IntersectionObserver.
   */
  const languageLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-language-base]')];

  document.addEventListener(SECTION_CHANGE_EVENT, (event) => {
    const sectionId = (event as CustomEvent<string>).detail;
    const hash = sectionId && sectionId !== sections.home ? `#${sectionId}` : '';

    languageLinks.forEach((link) => {
      link.setAttribute('href', `${link.dataset.languageBase}${hash}`);
    });
  });

  /*
   * Exact position across the switch. The section hash alone would make the
   * other language open at the top of the section. Instead, the element at the
   * reading line (a quarter of the way down the visible content) is remembered
   * by its position in the page structure, which is identical in both
   * languages, together with its distance from the top of the window. The
   * other page then puts that same element back at that same distance
   * (LanguageScrollRestore.astro), whatever the length of the translated text
   * above it. The links keep their section hash for visitors without JavaScript.
   */
  const STORAGE_KEY = 'bonaca:language-scroll';

  /** Child indices from <body> down to the element. */
  const pathOf = (element: Element) => {
    const path: number[] = [];
    let node: Element | null = element;
    while (node && node !== document.body) {
      const parent: Element | null = node.parentElement;
      if (!parent) return undefined;
      path.unshift([...parent.children].indexOf(node));
      node = parent;
    }
    return node === document.body ? path : undefined;
  };

  /** The page element at the reading line, ignoring the header and its mobile menu. */
  const elementAtReadingLine = () => {
    const header = document.querySelector('[data-site-header]');
    const contentTop = header ? header.getBoundingClientRect().bottom : 0;
    const y = Math.min(
      window.innerHeight - 1,
      contentTop + Math.max(8, (window.innerHeight - contentTop) * 0.25),
    );
    const ignored = new Set<Element | null>([document.documentElement, document.body, document.querySelector('main')]);
    for (const x of [0.5, 0.3, 0.7].map((share) => window.innerWidth * share)) {
      const element = document
        .elementsFromPoint(x, y)
        .find((candidate) => !ignored.has(candidate) && !header?.contains(candidate));
      if (element) return element;
    }
    return undefined;
  };

  languageLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      // Let the browser handle new-tab and other modified clicks.
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      const element = elementAtReadingLine();
      const path = element && pathOf(element);
      if (!element || !path) return;

      const target = new URL(link.href);
      try {
        sessionStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            pathname: target.pathname,
            hash: target.hash,
            path,
            offset: element.getBoundingClientRect().top,
            time: Date.now(),
          }),
        );
      } catch {
        return; // Storage unavailable: fall back to the plain link (section hash).
      }

      // Open the page without the hash, so the browser does not jump to the section.
      event.preventDefault();
      window.location.assign(target.pathname);
    });
  });
</script>

<style>
  .language-switcher__list {
    display: flex;
    align-items: center;
  }

  .language-switcher__item + .language-switcher__item::before {
    /* Visual separator only; hidden from assistive technology. */
    content: '|' / '';
    padding-inline: 0.6em;
    font-weight: 400;
  }

  .language-switcher__item {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
  }

  .language-switcher__link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.5em;
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .language-switcher__link:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 64rem) {
    .language-switcher__item {
      font-size: var(--text-xs);
      line-height: 1.75;
    }
  }
</style>
