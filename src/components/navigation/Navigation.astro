---
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';
import { getSectionHref, navigationItems, sections } from '@/i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<!--
  In-page navigation: every link is a native anchor to a section of the page
  (smooth scrolling and the URL hash are handled by the browser).
  The script below marks the link of the section currently in view.
-->
<nav class="navigation" aria-label={t('nav.label')}>
  <ul class="navigation__list" role="list">
    {navigationItems.map((sectionKey) => (
      <li>
        <a
          class="navigation__link"
          href={getSectionHref(sectionKey, locale)}
          aria-current={sectionKey === 'home' ? 'true' : undefined}
          data-nav-section={sections[sectionKey]}
        >
          {t(`nav.${sectionKey}`)}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  import { SECTION_CHANGE_EVENT } from '@/i18n/routes';

  /*
   * Active link = the section crossing a horizontal line at 40% of the viewport.
   * When the end of the page is visible, the last section is active (it may be
   * too short to ever reach that line). IntersectionObserver only, no scroll events.
   * Changes are announced with SECTION_CHANGE_EVENT (used by the language switcher).
   */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-section]')];
  const pageSections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  const pageEnd = document.querySelector('[data-page-end]');

  let sectionInView = pageSections[0]?.id;
  let atPageEnd = false;
  let announcedId: string | undefined;

  const render = () => {
    const activeId = atPageEnd ? pageSections.at(-1)?.id : sectionInView;
    links.forEach((link) => {
      if (link.dataset.navSection === activeId) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });

    if (activeId && activeId !== announcedId) {
      announcedId = activeId;
      document.dispatchEvent(new CustomEvent(SECTION_CHANGE_EVENT, { detail: activeId }));
    }
  };

  /*
   * Smooth scrolling is enabled only after the page has loaded, so arriving on a
   * URL with a hash (e.g. after switching language) jumps straight to the section
   * instead of visibly scrolling down from the top.
   */
  const enableSmoothScroll = () =>
    requestAnimationFrame(() => document.documentElement.setAttribute('data-smooth-scroll', ''));

  if (document.readyState === 'complete') enableSmoothScroll();
  else window.addEventListener('load', enableSmoothScroll, { once: true });

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) sectionInView = entry.target.id;
      });
      render();
    },
    { rootMargin: '-40% 0px -59% 0px' },
  );
  pageSections.forEach((section) => sectionObserver.observe(section));

  if (pageEnd) {
    new IntersectionObserver(([entry]) => {
      atPageEnd = entry.isIntersecting;
      render();
    }).observe(pageEnd);
  }
</script>

<style>
  .navigation__list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .navigation__link {
    display: inline-block;
    padding-block: var(--space-2xs);
    font-size: var(--text-md);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.7em;
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .navigation__link:hover,
  .navigation__link[aria-current='true'] {
    text-decoration-color: currentColor;
  }

  @media (min-width: 64rem) {
    .navigation__list {
      flex-direction: row;
      gap: clamp(1rem, 4.4vw - 1.25rem, 3.25rem);
    }

    .navigation__link {
      font-size: var(--text-xs);
      white-space: nowrap;
    }
  }
</style>
