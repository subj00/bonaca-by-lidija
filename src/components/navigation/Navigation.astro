---
import ChevronDownIcon from '@/assets/icons/chevron-down.svg';
import { educationArtists } from '@/data/educations';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';
import {
  getPath,
  getSectionHref,
  navigationItems,
  sections,
  serviceAnchors,
  type SectionKey,
} from '@/i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const pagePath = getPath('home', locale);

interface Submenu {
  id: string;
  /** Accessible name of the chevron button. */
  label: string;
  links: { title: string; href: string }[];
}

/*
 * Items with a submenu: Services (both artists' makeup and Ana's lash & brow
 * lift) and Educations (the four courses, in page order).
 */
const submenus: Partial<Record<SectionKey, Submenu>> = {
  services: {
    id: 'navigation-services-submenu',
    label: t('nav.servicesList'),
    links: [
      { title: t('nav.servicesLidija'), href: `${pagePath}#${serviceAnchors.lidija}` },
      { title: t('nav.servicesAna'), href: `${pagePath}#${serviceAnchors.ana}` },
      { title: t('nav.servicesLashBrow'), href: `${pagePath}#${serviceAnchors.lashBrowLift}` },
    ],
  },
  education: {
    id: 'navigation-education-submenu',
    label: t('nav.educationCourses'),
    links: educationArtists.flatMap((artist) =>
      artist.courses.map((course) => ({
        title: course.title[locale],
        href: `${pagePath}#${course.id}`,
      })),
    ),
  },
};
---

<!--
  In-page navigation: every link is a native anchor to a section of the page
  (smooth scrolling and the URL hash are handled by the browser).
  The script below marks the link of the section currently in view.

  Services and Educations have a submenu. The label stays a normal link to the
  section; a separate chevron button opens the submenu (a dropdown on desktop,
  an expandable list inside the mobile menu). Only one submenu is open at a time.
-->
<nav class="navigation" aria-label={t('nav.label')}>
  <ul class="navigation__list" role="list">
    {navigationItems.map((sectionKey) => {
      const submenu = submenus[sectionKey];
      return submenu ? (
        <li class="navigation__item navigation__item--submenu" data-submenu>
          <div class="navigation__row">
            <a
              class="navigation__link"
              href={getSectionHref(sectionKey, locale)}
              data-nav-section={sections[sectionKey]}
            >
              {t(`nav.${sectionKey}`)}
            </a>
            <button
              class="navigation__submenu-toggle"
              type="button"
              aria-expanded="false"
              aria-controls={submenu.id}
              aria-label={submenu.label}
              data-submenu-toggle
            >
              <ChevronDownIcon class="navigation__chevron" aria-hidden="true" />
            </button>
          </div>
          <div class="navigation__dropdown" id={submenu.id} data-submenu-panel>
            <div class="navigation__dropdown-inner">
              <ul class="navigation__submenu" role="list">
                {submenu.links.map((link) => (
                  <li>
                    <a class="navigation__sublink" href={link.href}>
                      {link.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ) : (
        <li class="navigation__item">
          <a
            class="navigation__link"
            href={getSectionHref(sectionKey, locale)}
            aria-current={sectionKey === 'home' ? 'true' : undefined}
            data-nav-section={sections[sectionKey]}
          >
            {t(`nav.${sectionKey}`)}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<script>
  import { SECTION_CHANGE_EVENT } from '@/i18n/routes';

  /*
   * Active link = the section crossing a horizontal line at 40% of the viewport.
   * When the end of the page is visible, the last section is active (it may be
   * too short to ever reach that line). IntersectionObserver only, no scroll events.
   * Changes are announced with SECTION_CHANGE_EVENT (used by the language switcher).
   */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-section]')];
  const pageSections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  const pageEnd = document.querySelector('[data-page-end]');

  let sectionInView = pageSections[0]?.id;
  let atPageEnd = false;
  let announcedId: string | undefined;

  const render = () => {
    const activeId = atPageEnd ? pageSections.at(-1)?.id : sectionInView;
    links.forEach((link) => {
      if (link.dataset.navSection === activeId) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });

    if (activeId && activeId !== announcedId) {
      announcedId = activeId;
      document.dispatchEvent(new CustomEvent(SECTION_CHANGE_EVENT, { detail: activeId }));
    }
  };

  /*
   * Smooth scrolling is enabled only after the page has loaded, so arriving on a
   * URL with a hash (e.g. after switching language) jumps straight to the section
   * instead of visibly scrolling down from the top.
   */
  const enableSmoothScroll = () =>
    requestAnimationFrame(() => document.documentElement.setAttribute('data-smooth-scroll', ''));

  if (document.readyState === 'complete') enableSmoothScroll();
  else window.addEventListener('load', enableSmoothScroll, { once: true });

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) sectionInView = entry.target.id;
      });
      render();
    },
    { rootMargin: '-40% 0px -59% 0px' },
  );
  pageSections.forEach((section) => sectionObserver.observe(section));

  if (pageEnd) {
    new IntersectionObserver(([entry]) => {
      atPageEnd = entry.isIntersecting;
      render();
    }).observe(pageEnd);
  }

  /*
   * Services and Educations submenus. The chevron button toggles one
   * (`aria-expanded` on the button, `data-open` on the item; CSS animates).
   * Opening one closes the other. Desktop only: a submenu also opens on mouse
   * hover and closes on Escape, an outside click or when focus leaves.
   * Choosing a link closes it; the mobile menu closes itself on any link.
   */
  const DESKTOP_QUERY = window.matchMedia('(min-width: 64rem)');
  const HOVER_CLOSE_DELAY = 150;
  const closers: Array<(except: HTMLElement) => void> = [];

  document.querySelectorAll<HTMLElement>('[data-submenu]').forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('[data-submenu-toggle]');
    const panel = item.querySelector<HTMLElement>('[data-submenu-panel]');
    if (!toggle || !panel) return;

    let closeTimer: number | undefined;
    // Opened by hover: a click on the chevron then keeps it open instead of closing it.
    let openedByHover = false;
    const isOpen = () => item.hasAttribute('data-open');
    const setOpen = (open: boolean) => {
      window.clearTimeout(closeTimer);
      if (!open) openedByHover = false;
      else closers.forEach((close) => close(item));
      item.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    closers.push((except) => {
      if (except !== item && isOpen()) setOpen(false);
    });

    toggle.addEventListener('click', () => {
      if (openedByHover) openedByHover = false;
      else setOpen(!isOpen());
    });

    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });

    // Hover (desktop mouse only); a short delay lets the pointer cross into the dropdown.
    item.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse' || !DESKTOP_QUERY.matches) return;
      if (!isOpen()) {
        setOpen(true);
        openedByHover = true;
      }
      window.clearTimeout(closeTimer);
    });
    item.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse' || !DESKTOP_QUERY.matches) return;
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => setOpen(false), HOVER_CLOSE_DELAY);
    });

    document.addEventListener('click', (event) => {
      if (DESKTOP_QUERY.matches && isOpen() && !item.contains(event.target as Node)) {
        setOpen(false);
      }
    });

    item.addEventListener('focusout', (event) => {
      if (DESKTOP_QUERY.matches && !item.contains(event.relatedTarget as Node | null)) {
        setOpen(false);
      }
    });

    // On phones Escape closes the whole mobile menu (handled by MobileMenu).
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !DESKTOP_QUERY.matches || !isOpen()) return;
      const focusWasInside = item.contains(document.activeElement);
      setOpen(false);
      if (focusWasInside) toggle.focus();
    });

    // Start closed whenever the layout switches between phone and desktop.
    DESKTOP_QUERY.addEventListener('change', () => setOpen(false));
  });
</script>

<style>
  .navigation__list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .navigation__link {
    display: inline-block;
    padding-block: var(--space-2xs);
    font-size: var(--text-md);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.7em;
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .navigation__link:hover,
  .navigation__link[aria-current='true'] {
    text-decoration-color: currentColor;
  }

  /* ---- Submenus (Services, Educations): phones (inside the mobile menu) ---- */

  .navigation__item--submenu {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /*
   * The label stays centred like the other items; the chevron sits just to its
   * right, outside the label's box, with a comfortable 44px tap target.
   */
  .navigation__row {
    position: relative;
  }

  .navigation__submenu-toggle {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 100%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    translate: 0 -50%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .navigation__submenu-toggle:focus-visible,
  .navigation__sublink:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 2px;
  }

  .navigation__chevron {
    width: 1.125rem;
    height: 1.125rem;
    transition: rotate var(--duration-base) var(--ease-out);
  }

  [data-open] > .navigation__row .navigation__chevron {
    rotate: 180deg;
  }

  /* Expands smoothly (grid row 0fr → 1fr); hidden content is skipped by keyboard. */
  .navigation__dropdown {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows var(--duration-base) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out),
      visibility 0s linear var(--duration-base);
  }

  [data-open] > .navigation__dropdown {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition:
      grid-template-rows var(--duration-base) var(--ease-out),
      opacity var(--duration-base) var(--ease-out),
      visibility 0s;
  }

  .navigation__dropdown-inner {
    min-height: 0;
    overflow: hidden;
  }

  /* Indented under a thin line, smaller than the main items. */
  .navigation__submenu {
    display: flex;
    flex-direction: column;
    margin-block-start: var(--space-sm);
    padding-inline-start: var(--space-md);
    border-inline-start: 1px solid color-mix(in srgb, var(--color-smoky-rose) 30%, transparent);
  }

  .navigation__sublink {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    /* Reading text colour, at full strength in every state. */
    color: var(--color-text-body);
  }

  /* ---- Desktop: a compact Linen dropdown under the label ---- */

  @media (min-width: 64rem) {
    /*
     * Four items: about 58px apart at 1440px, up to 60px on wide screens, and
     * narrowing on smaller desktops (about 33px at 1024px) so nothing meets the
     * logo or the language switcher.
     */
    .navigation__list {
      flex-direction: row;
      gap: clamp(1.5rem, 6vw - 1.75rem, 3.75rem);
    }

    .navigation__link {
      font-size: var(--text-xs);
      white-space: nowrap;
    }

    .navigation__item--submenu {
      position: relative;
      display: block;
    }

    .navigation__row {
      display: flex;
      align-items: center;
    }

    .navigation__submenu-toggle {
      position: static;
      width: 1.5rem;
      height: 1.5rem;
      margin-inline-end: -0.375rem;
      translate: none;
    }

    .navigation__chevron {
      width: 0.875rem;
      height: 0.875rem;
    }

    /*
     * Floating menu centred under the item. The transparent top padding is the
     * gap below the navigation and bridges it, so the pointer can move into the
     * menu without leaving the item (the dropdown stays open). It fades in with
     * a 4px drift only.
     */
    .navigation__dropdown {
      position: absolute;
      z-index: 20;
      inset-block-start: 100%;
      inset-inline-start: 50%;
      display: block;
      padding-block-start: 0.875rem;
      translate: -50% -0.25rem;
      transition:
        opacity 160ms var(--ease-out),
        translate 160ms var(--ease-out),
        visibility 0s linear 160ms;
    }

    [data-open] > .navigation__dropdown {
      translate: -50% 0;
      transition:
        opacity 200ms var(--ease-out),
        translate 200ms var(--ease-out),
        visibility 0s;
    }

    .navigation__dropdown-inner {
      overflow: visible;
    }

    .navigation__submenu {
      gap: 0.125rem;
      min-width: 13.5rem;
      margin: 0;
      padding: 0.625rem;
      border: 1px solid color-mix(in srgb, var(--color-smoky-rose) 12%, transparent);
      border-radius: 0.5625rem;
      background-color: var(--color-linen);
      box-shadow:
        0 1px 2px color-mix(in srgb, var(--color-smoky-rose) 5%, transparent),
        0 12px 32px -8px color-mix(in srgb, var(--color-smoky-rose) 16%, transparent);
    }

    .navigation__sublink {
      min-height: 0;
      padding: 0.5rem 0.75rem;
      border-radius: 0.3125rem;
      font-size: var(--text-sm);
      white-space: nowrap;
      transition: background-color 180ms var(--ease-out);
    }

    /* Hover: a barely-there Taupe tint. */
    .navigation__sublink:hover,
    .navigation__sublink:focus-visible {
      background-color: color-mix(in srgb, var(--color-taupe) 10%, transparent);
    }

    .navigation__sublink:focus-visible {
      outline-offset: -2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navigation__chevron,
    .navigation__dropdown,
    [data-open] > .navigation__dropdown {
      transition: none;
    }
  }

  /* Without JavaScript the submenu cannot open: the label link still works. */
  @media (scripting: none) {
    .navigation__submenu-toggle,
    .navigation__dropdown {
      display: none;
    }
  }
</style>
