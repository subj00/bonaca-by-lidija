---
import { Image } from 'astro:assets';
import ArrowIcon from '@/assets/icons/arrow.svg';
import heroPhoto from '@/assets/images/home/home-page.png';
import { site } from '@/config/site';
import { studioServices } from '@/data/services';
import { getLocale } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';
import { getSectionHref, sections } from '@/i18n/routes';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Desktop calls to action (three identical buttons).
const actions = [
  { label: t('home.hero.ctaServices'), href: getSectionHref('services', locale) },
  { label: t('home.hero.ctaEducation'), href: getSectionHref('education', locale) },
  { label: t('home.hero.ctaContact'), href: getSectionHref('contact', locale) },
];
---

<section class="hero" id={sections.home} data-section>
  <Image
    class="hero__photo"
    src={heroPhoto}
    alt={t('home.hero.imageAlt')}
    widths={[480, 720, 1040, 1312]}
    sizes="(min-width: 64rem) 62vw, 140vw"
    priority
  />

  <!--
    The logo is shown in the header on every screen size, so the page heading is
    kept for assistive technology and search engines but not shown.
  -->
  <h1 class="hero__title">{site.name}</h1>

  <!--
    The three services (phones and desktop) and the calls to action (desktop
    only). Phones: the services below the photograph, in place of a second logo.
  -->
  <div class="hero__intro">
    <ul class="hero__services" role="list">
      {studioServices.map((service) => <li class="hero__service">{service}</li>)}
    </ul>

    <ul class="hero__actions" role="list">
      {
        actions.map((action) => (
          <li>
            <a class="hero__action" href={action.href}>
              <span>{action.label}</span>
              <ArrowIcon class="hero__action-icon" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /*
   * Mobile layout, derived from the real header height and the initial
   * (small) viewport height:
   *   photo top    = header height + a very small gap
   *   photo height = remaining screen height, capped so faces are never cropped
   *   services     = a little below the end of the photograph's fade (part of
   *                  the free space below it, so the gap stays modest)
   *   hero height  = at least one full screen (100svh)
   */
  .hero {
    --photo-top: calc(var(--header-height-mobile) + var(--space-2xs));
    /*
     * Space reserved below the photograph when sizing it (unchanged, so the
     * photograph keeps exactly its previous size and position).
     */
    --photo-reserve: calc(min(74vw, 24rem) * var(--logo-aspect) * 0.4 + 4rem);
    --photo-height: clamp(18rem, 100svh - var(--photo-top) - var(--photo-reserve), 125vw);
    /* Where the photograph's fade ends (matches the last stop of its mask). */
    --photo-fade-end: calc(var(--photo-top) + var(--photo-height) * 0.99);
    /* Service labels on phones: three lines of Tenor Sans with small gaps. */
    --service-size: clamp(1rem, 4.4vw, 1.25rem);
    --service-gap: 0.625rem;
    --intro-height: calc(var(--service-size) * 1.25 * 3 + var(--service-gap) * 2);
    --intro-bottom-space: 2rem;
    --intro-free-space: calc(
      100svh - var(--intro-bottom-space) - var(--intro-height) - var(--photo-fade-end)
    );
    /* The last 1.5rem is extra breathing room between the photograph and the labels. */
    --intro-top: calc(
      var(--photo-fade-end) + clamp(var(--space-md), var(--intro-free-space) * 0.35, 3.5rem) +
        1.5rem
    );

    position: relative;
    isolation: isolate;
    min-height: 100svh;
    height: calc(var(--intro-top) + var(--intro-height) + var(--space-lg));
    overflow: hidden;
  }

  /*
   * The photograph is a transparent cut-out, so it is sized by height and
   * centred horizontally: both women stay visible and nothing is stretched.
   * Only the lower edge fades, straight into the Linen page behind it (no
   * overlay). The eased mask keeps the photo fully opaque down to 66% and
   * then dissolves gradually, so the fade has no visible edge.
   */
  .hero__photo {
    position: absolute;
    z-index: -1;
    inset-block-start: var(--photo-top);
    inset-inline-start: 50%;
    width: auto;
    max-width: none;
    height: var(--photo-height);
    translate: -50% 0;
    mask-image: linear-gradient(
      to bottom,
      black 66%,
      rgb(0 0 0 / 0.92) 73%,
      rgb(0 0 0 / 0.74) 80%,
      rgb(0 0 0 / 0.48) 87%,
      rgb(0 0 0 / 0.22) 93%,
      rgb(0 0 0 / 0.06) 97%,
      transparent 99%
    );
  }

  /* Visually hidden page heading (the logo is in the header). */
  .hero__title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /*
   * Phones: the three service labels, centred below the photograph, in the
   * same Tenor Sans, uppercase and spacing as on desktop (no hairlines).
   * The calls to action are desktop only.
   */
  @media (width < 64rem) {
    .hero__intro {
      position: absolute;
      inset-block-start: var(--intro-top);
      inset-inline: var(--frame-padding-inline);
    }

    .hero__services {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--service-gap);
      padding: 0;
    }

    .hero__service {
      font-family: var(--font-display);
      font-size: var(--service-size);
      font-weight: 400;
      line-height: 1.25;
      letter-spacing: 0.14em;
      /* Balances the trailing letter-spacing so each label is optically centred. */
      padding-inline-start: 0.14em;
      text-transform: uppercase;
      white-space: nowrap;
      color: var(--color-smoky-rose);
    }

    .hero__actions {
      display: none;
    }
  }

  /*
   * Desktop: asymmetrical split. The photograph sits on the left, starting at
   * the header's left content edge; the services and calls to action are
   * centred in the space to its right, below the header.
   */
  @media (min-width: 64rem) {
    .hero {
      --hero-height: max(100svh, 38rem);
      /* Photograph's width / height (525 × 480 source). */
      --photo-ratio: 1.09375;
      /*
       * Size (unchanged by the position below): on shorter screens the
       * photograph is 20% taller than the space below the header, so its faded
       * lower part continues below the fold. It never takes more than 62% of
       * the content width, which keeps room for the logo on wider screens.
       */
      --photo-height: min(
        (var(--hero-height) - var(--header-height-desktop) - 1.75rem) * 1.2,
        (100vw - 2 * var(--content-inset)) * 0.62 / var(--photo-ratio)
      );
      --photo-width: calc(var(--photo-height) * var(--photo-ratio));
      /*
       * Position: measured from the visible header row (logo and navigation),
       * not from the header box, whose bottom padding is transparent empty
       * space. The hair starts ~1.3% below the top of the image, so the hair
       * sits about 30–40px below the header row on every desktop size.
       */
      --photo-top: calc(
        var(--header-height-desktop) - var(--header-padding-block-desktop) + 1.25rem
      );
      /*
       * Part of the photograph above the bottom of the hero: all of it when it
       * ends above the bottom (its fade then completes on the beige page).
       */
      --photo-visible: min(var(--photo-height), var(--hero-height) - var(--photo-top));
      /* Free width to the right of the photograph (inside the content edges). */
      --intro-width: calc(100vw - 2 * var(--content-inset) - var(--photo-width));
      /*
       * Service labels: about 18% smaller than the largest size the column
       * allows (the longest label, "PROFESSIONAL MAKE UP", is ~16em wide).
       */
      --service-size: clamp(1rem, (var(--intro-width) - 3rem) / 16 * 0.82, 1.625rem);

      height: 100svh;
      min-height: 38rem;
    }

    .hero__photo {
      inset-block-start: var(--photo-top);
      inset-inline-start: var(--content-inset);
      width: var(--photo-width);
      height: var(--photo-height);
      translate: none;
      /*
       * Same soft fade as on mobile, measured on the visible part, so it always
       * ends exactly at the bottom of the hero (never cut off mid-fade).
       */
      mask-image: linear-gradient(
        to bottom,
        black calc(var(--photo-visible) * 0.66),
        rgb(0 0 0 / 0.92) calc(var(--photo-visible) * 0.73),
        rgb(0 0 0 / 0.74) calc(var(--photo-visible) * 0.8),
        rgb(0 0 0 / 0.48) calc(var(--photo-visible) * 0.87),
        rgb(0 0 0 / 0.22) calc(var(--photo-visible) * 0.93),
        rgb(0 0 0 / 0.06) calc(var(--photo-visible) * 0.97),
        transparent calc(var(--photo-visible) * 0.99)
      );
    }

    /*
     * Right column: from the photograph's right edge to the header's right
     * content edge, vertically centred in the area below the header.
     */
    .hero__intro {
      position: absolute;
      inset-block: var(--header-height-desktop) 0;
      inset-inline: calc(var(--content-inset) + var(--photo-width)) var(--content-inset);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      /* Space from the hairline below the services to the first button. */
      gap: clamp(3.125rem, 5svh + 1.125rem, 4.125rem);
      color: var(--color-smoky-rose);
    }

    /*
     * Tenor Sans, the same display face as the section headings, framed by
     * two short decorative hairlines (above the first and below the last label).
     */
    .hero__services {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(0.5rem, 1.6svh, 0.875rem);
      padding: 0;
    }

    .hero__services::before,
    .hero__services::after {
      content: '';
      width: 5rem;
      border-block-start: 1px solid color-mix(in srgb, var(--color-smoky-rose) 55%, transparent);
    }

    .hero__services::before {
      margin-block-end: clamp(0.75rem, 2svh, 1.25rem);
    }

    .hero__services::after {
      margin-block-start: clamp(0.75rem, 2svh, 1.25rem);
    }

    /* All three labels in Smoky Rose, the same colour as the button hover fill. */
    .hero__service {
      font-family: var(--font-display);
      font-size: var(--service-size);
      font-weight: 400;
      line-height: 1.25;
      letter-spacing: 0.14em;
      /* Balances the trailing letter-spacing so each label is optically centred. */
      padding-inline-start: 0.14em;
      text-transform: uppercase;
      white-space: nowrap;
      color: var(--color-smoky-rose);
    }

    /*
     * Three identical outlined pill buttons (Smoky Rose text, arrow and border
     * on the Linen page); on hover each fills with Smoky Rose and turns white.
     */
    .hero__actions {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      width: min(17rem, 100%);
      padding: 0;
    }

    .hero__action {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-sm);
      height: 3rem;
      padding-inline: var(--space-lg);
      border: 1px solid var(--color-smoky-rose);
      /* Soft pill shape. */
      border-radius: 9999px;
      font-size: var(--text-xs);
      font-weight: var(--font-weight-semibold);
      letter-spacing: 0.18em;
      text-decoration: none;
      text-transform: uppercase;
      background-color: transparent;
      color: var(--color-smoky-rose);
      transition:
        background-color 250ms var(--ease-out),
        color 250ms var(--ease-out);
    }

    .hero__action-icon {
      flex-shrink: 0;
      width: 1.125rem;
      height: 0.5625rem;
      transition: translate 250ms var(--ease-out);
    }

    /* Only for pointers that can hover; touch screens keep the default look. */
    @media (hover: hover) {
      .hero__action:hover {
        background-color: var(--color-smoky-rose);
        color: var(--color-white);
      }

      .hero__action:hover .hero__action-icon {
        translate: 3px 0;
      }
    }
  }

  @media (min-width: 64rem) and (prefers-reduced-motion: reduce) {
    .hero__action,
    .hero__action-icon {
      transition: none;
    }
  }
</style>
