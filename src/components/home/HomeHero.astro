---
import { Image } from 'astro:assets';
import heroPhoto from '@/assets/images/home/home-page.png';
import Logo from '@/components/ui/Logo.astro';
import { getLocale } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';
import { sections } from '@/i18n/routes';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="hero" id={sections.home} data-section>
  <Image
    class="hero__photo"
    src={heroPhoto}
    alt={t('home.hero.imageAlt')}
    widths={[480, 720, 960, 1312]}
    sizes="(min-width: 64rem) 100vh, 140vw"
    priority
  />

  <h1 class="hero__title">
    <Logo sizes="(min-width: 64rem) min(38vw, 62vh, 36rem), min(74vw, 24rem)" />
  </h1>
</section>

<style>
  /*
   * Mobile layout, derived from the real header height and the initial
   * (small) viewport height:
   *   photo top    = header height + small gap
   *   photo height = remaining screen height, capped so faces are never cropped
   *   logo         = anchored near the bottom of the first screen, but never
   *                  above the end of the photograph's fade
   *   hero height  = at least one full screen (100svh)
   */
  .hero {
    --photo-top: calc(var(--header-height-mobile) + var(--space-sm));
    --title-width: min(74vw, 24rem);
    --title-height: calc(var(--title-width) * var(--logo-aspect));
    /*
     * Space reserved below the photograph when sizing it. Kept independent of
     * the logo position, so moving the logo never resizes the photograph.
     */
    --photo-reserve: calc(var(--title-height) * 0.4 + 4rem);
    --photo-height: clamp(18rem, 100svh - var(--photo-top) - var(--photo-reserve), 125vw);
    /* Where the photograph's fade ends (matches the 98% stop of its mask). */
    --photo-fade-end: calc(var(--photo-top) + var(--photo-height) * 0.98);
    --title-bottom-space: 2rem;
    --title-top: max(
      100svh - var(--title-bottom-space) - var(--title-height),
      var(--photo-fade-end) + var(--space-xs)
    );

    position: relative;
    isolation: isolate;
    min-height: 100svh;
    height: calc(var(--title-top) + var(--title-height) + var(--space-lg));
    overflow: hidden;
  }

  /*
   * The photograph is a transparent cut-out, so it is sized by height and
   * centred horizontally: both women stay visible and nothing is stretched.
   * Only the lower edge fades into the background.
   */
  .hero__photo {
    position: absolute;
    z-index: -1;
    inset-block-start: var(--photo-top);
    inset-inline-start: 50%;
    width: auto;
    max-width: none;
    height: var(--photo-height);
    translate: -50% 0;
    mask-image: linear-gradient(to bottom, black 60%, transparent 98%);
  }

  .hero__title {
    position: absolute;
    inset-block-start: var(--title-top);
    inset-inline-start: 50%;
    width: var(--title-width);
    translate: -50% 0;
  }

  /* Soft, localized light behind the logo to keep it legible over the photograph. */
  .hero__title::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -70% -20% -60%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-linen) 78%, transparent) 30%,
      transparent
    );
  }

  @media (min-width: 64rem) {
    .hero {
      height: 100svh;
      min-height: 38rem;
    }

    .hero__photo {
      inset-block-start: 10%;
      height: 102%;
      mask-image: none;
    }

    .hero__title {
      inset-block-start: auto;
      inset-block-end: 8%;
      width: min(38vw, 62svh, 36rem);
    }
  }
</style>
