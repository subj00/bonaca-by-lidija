---
import { Image } from 'astro:assets';
import heroPhoto from '@/assets/images/home/home-page.png';
import Logo from '@/components/ui/Logo.astro';
import { getLocale } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';
import { sections } from '@/i18n/routes';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="hero" id={sections.home} data-section>
  <Image
    class="hero__photo"
    src={heroPhoto}
    alt={t('home.hero.imageAlt')}
    widths={[480, 720, 960, 1312]}
    sizes="(min-width: 64rem) 62vw, 140vw"
    priority
  />

  <h1 class="hero__title">
    <Logo sizes="(min-width: 64rem) min(38vw, 66vh, 38rem), min(61vw, 20rem)" />
  </h1>
</section>

<style>
  /*
   * Mobile layout, derived from the real header height and the initial
   * (small) viewport height:
   *   photo top    = header height + a very small gap
   *   photo height = remaining screen height, capped so faces are never cropped
   *   logo         = centred in the space between the end of the photograph's
   *                  fade and the bottom of the first screen (at least 1rem
   *                  below the fade), so the gaps above and below stay balanced
   *   hero height  = at least one full screen (100svh)
   */
  .hero {
    --photo-top: calc(var(--header-height-mobile) + var(--space-2xs));
    /* Hero logo about 18% smaller than the original min(74vw, 24rem). */
    --title-width: min(61vw, 20rem);
    --title-height: calc(var(--title-width) * var(--logo-aspect));
    /*
     * Space reserved below the photograph when sizing it. Kept independent of
     * the logo size and position, so changing the logo never resizes the photograph.
     */
    --photo-reserve: calc(min(74vw, 24rem) * var(--logo-aspect) * 0.4 + 4rem);
    --photo-height: clamp(18rem, 100svh - var(--photo-top) - var(--photo-reserve), 125vw);
    /* Where the photograph's fade ends (matches the last stop of its mask). */
    --photo-fade-end: calc(var(--photo-top) + var(--photo-height) * 0.99);
    --title-bottom-space: 2rem;
    --title-free-space: calc(
      100svh - var(--title-bottom-space) - var(--title-height) - var(--photo-fade-end)
    );
    --title-top: calc(
      var(--photo-fade-end) + max(var(--space-md), var(--title-free-space) * 0.5)
    );

    position: relative;
    isolation: isolate;
    min-height: 100svh;
    height: calc(var(--title-top) + var(--title-height) + var(--space-lg));
    overflow: hidden;
  }

  /*
   * The photograph is a transparent cut-out, so it is sized by height and
   * centred horizontally: both women stay visible and nothing is stretched.
   * Only the lower edge fades, straight into the Linen page behind it (no
   * overlay). The eased mask keeps the photo fully opaque down to 66% and
   * then dissolves gradually, so the fade has no visible edge.
   */
  .hero__photo {
    position: absolute;
    z-index: -1;
    inset-block-start: var(--photo-top);
    inset-inline-start: 50%;
    width: auto;
    max-width: none;
    height: var(--photo-height);
    translate: -50% 0;
    mask-image: linear-gradient(
      to bottom,
      black 66%,
      rgb(0 0 0 / 0.92) 73%,
      rgb(0 0 0 / 0.74) 80%,
      rgb(0 0 0 / 0.48) 87%,
      rgb(0 0 0 / 0.22) 93%,
      rgb(0 0 0 / 0.06) 97%,
      transparent 99%
    );
  }

  .hero__title {
    position: absolute;
    inset-block-start: var(--title-top);
    inset-inline-start: 50%;
    width: var(--title-width);
    translate: -50% 0;
  }

  /*
   * Desktop: asymmetrical split. The photograph sits on the left, starting at
   * the header's left content edge; the large logo is centred in the space to
   * its right, slightly above the middle of the area below the header.
   */
  @media (min-width: 64rem) {
    .hero {
      --hero-height: max(100svh, 38rem);
      /* Photograph's width / height (525 × 480 source). */
      --photo-ratio: 1.09375;
      /*
       * Size (unchanged by the position below): on shorter screens the
       * photograph is 20% taller than the space below the header, so its faded
       * lower part continues below the fold. It never takes more than 62% of
       * the content width, which keeps room for the logo on wider screens.
       */
      --photo-height: min(
        (var(--hero-height) - var(--header-height-desktop) - 1.75rem) * 1.2,
        (100vw - 2 * var(--content-inset)) * 0.62 / var(--photo-ratio)
      );
      --photo-width: calc(var(--photo-height) * var(--photo-ratio));
      /*
       * Position: measured from the visible header row (logo and navigation),
       * not from the header box, whose bottom padding is transparent empty
       * space. The hair starts ~1.3% below the top of the image, so the hair
       * sits about 30–40px below the header row on every desktop size.
       */
      --photo-top: calc(
        var(--header-height-desktop) - var(--header-padding-block-desktop) + 1.25rem
      );
      /*
       * Part of the photograph above the bottom of the hero: all of it when it
       * ends above the bottom (its fade then completes on the beige page).
       */
      --photo-visible: min(var(--photo-height), var(--hero-height) - var(--photo-top));
      /*
       * Large logo: about 25–30% larger than before, limited by the free space
       * to the right of the photograph (with room on both sides).
       */
      --title-width: min(
        38vw,
        66svh,
        38rem,
        100% - 2 * var(--content-inset) - var(--photo-width) - 2 * var(--space-xl)
      );

      height: 100svh;
      min-height: 38rem;
    }

    .hero__photo {
      inset-block-start: var(--photo-top);
      inset-inline-start: var(--content-inset);
      width: var(--photo-width);
      height: var(--photo-height);
      translate: none;
      /*
       * Same soft fade as on mobile, measured on the visible part, so it always
       * ends exactly at the bottom of the hero (never cut off mid-fade).
       */
      mask-image: linear-gradient(
        to bottom,
        black calc(var(--photo-visible) * 0.66),
        rgb(0 0 0 / 0.92) calc(var(--photo-visible) * 0.73),
        rgb(0 0 0 / 0.74) calc(var(--photo-visible) * 0.8),
        rgb(0 0 0 / 0.48) calc(var(--photo-visible) * 0.87),
        rgb(0 0 0 / 0.22) calc(var(--photo-visible) * 0.93),
        rgb(0 0 0 / 0.06) calc(var(--photo-visible) * 0.97),
        transparent calc(var(--photo-visible) * 0.99)
      );
    }

    /*
     * Centred in the space to the right of the photograph, about 36px above
     * the middle of the area between the header and the bottom of the hero.
     */
    .hero__title {
      inset-block-start: calc(
        (var(--header-height-desktop) + var(--hero-height)) / 2 - 2.25rem
      );
      inset-inline-start: calc((var(--photo-width) + 100%) / 2);
      translate: -50% -50%;
    }
  }
</style>
