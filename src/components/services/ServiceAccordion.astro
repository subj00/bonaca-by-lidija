---
import AccordionItem from '@/components/ui/AccordionItem.astro';

interface Item {
  id: string;
  title: string;
  description: string;
  /** Optional in-page anchor on the row (a navigation target). */
  anchorId?: string | undefined;
}

interface Props {
  /** Prefix for the element ids (unique on the page). */
  idPrefix: string;
  items: Item[];
  /** Index of the row that starts expanded (the first one, as in the design). */
  openIndex?: number;
  /** Level of the row headings, one below the heading they sit under. */
  headingLevel?: 3 | 4;
}

const { idPrefix, items, openIndex = 0, headingLevel = 3 } = Astro.props;
---

<!-- Ana's treatment rows: the shared accordion rows, each with one paragraph. -->
<div class="accordion">
  {
    items.map((item, index) => (
      <AccordionItem
        id={`${idPrefix}-${item.id}`}
        anchorId={item.anchorId}
        title={item.title}
        open={index === openIndex}
        headingLevel={headingLevel}
      >
        <p>{item.description}</p>
      </AccordionItem>
    ))
  }
</div>

<style>
  .accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
</style>
