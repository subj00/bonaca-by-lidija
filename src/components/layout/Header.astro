---
import type { Locale } from '@/i18n/config';
import { getSectionHref, type RouteKey } from '@/i18n/routes';
import LanguageSwitcher from '@/components/navigation/LanguageSwitcher.astro';
import MobileMenu from '@/components/navigation/MobileMenu.astro';
import Navigation from '@/components/navigation/Navigation.astro';
import Logo from '@/components/ui/Logo.astro';

interface Props {
  locale: Locale;
  currentRoute: RouteKey;
}

const { locale, currentRoute } = Astro.props;
---

<!--
  Fixed at the top of the one-page site. Transparent over the hero; once the
  page is scrolled it gets the Linen background so it stays readable over content.
-->
<header class="site-header" data-site-header>
  <a class="site-header__brand" href={getSectionHref('home', locale)}>
    <Logo sizes="(min-width: 64rem) 12.25rem, 8.5rem" />
  </a>

  <MobileMenu locale={locale}>
    <Navigation locale={locale} />
    <LanguageSwitcher locale={locale} currentRoute={currentRoute} />
  </MobileMenu>
</header>

<script>
  // Toggle the header background when the top-of-page marker leaves the viewport.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const topMarker = document.querySelector('[data-page-top]');

  if (header && topMarker) {
    new IntersectionObserver(([entry]) => {
      header.dataset.scrolled = String(!entry.isIntersecting);
    }).observe(topMarker);
  }
</script>

<style>
  /* Mobile: logo on the left and hamburger on the right, in a single row. */
  .site-header {
    position: fixed;
    z-index: 10;
    inset-block-start: 0;
    inset-inline: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: var(--frame-padding-block) var(--content-inset);
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .site-header[data-scrolled='true'] {
    background-color: var(--color-background);
  }

  .site-header__brand {
    display: block;
    width: var(--header-logo-width-mobile);
    /* Optical correction: aligns the BONACA wordmark, not the whole artwork box. */
    translate: 0 var(--logo-optical-offset);
  }

  /*
   * Desktop: three columns with equal flexible sides, so the navigation sits in
   * the true centre of the header. MobileMenu's wrappers use `display: contents`,
   * which makes the navigation and language switcher direct grid items.
   */
  @media (min-width: 64rem) {
    .site-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      column-gap: var(--space-lg);
      padding-block: var(--header-padding-block-desktop);
    }

    .site-header__brand {
      justify-self: start;
      width: var(--header-logo-width-desktop);
    }

    .site-header :global(.language-switcher) {
      justify-self: end;
    }
  }
</style>
