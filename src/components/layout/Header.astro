---
import type { Locale } from '@/i18n/config';
import { getPath, type RouteKey } from '@/i18n/routes';
import LanguageSwitcher from '@/components/navigation/LanguageSwitcher.astro';
import MobileMenu from '@/components/navigation/MobileMenu.astro';
import Navigation from '@/components/navigation/Navigation.astro';
import Logo from '@/components/ui/Logo.astro';

interface Props {
  locale: Locale;
  currentRoute: RouteKey;
  /** Positions the header over the first page section instead of in the flow. */
  overlay?: boolean;
}

const { locale, currentRoute, overlay = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <a class="site-header__brand" href={getPath('home', locale)}>
    <Logo sizes="(min-width: 64rem) 12.25rem, 8.5rem" />
  </a>

  <MobileMenu locale={locale}>
    <Navigation locale={locale} currentRoute={currentRoute} />
    <LanguageSwitcher locale={locale} currentRoute={currentRoute} />
  </MobileMenu>
</header>

<style>
  /* Mobile: logo on the left and hamburger on the right, in a single row. */
  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: var(--frame-padding-block) var(--frame-padding-inline);
  }

  /* Anchored to the top edge so it sits above the photograph. */
  .site-header--overlay {
    position: absolute;
    inset-block-start: 0;
    inset-inline: var(--page-gutter);
  }

  .site-header__brand {
    display: block;
    width: var(--header-logo-width-mobile);
    /* Optical correction: aligns the BONACA wordmark, not the whole artwork box. */
    translate: 0 var(--logo-optical-offset);
  }

  /*
   * Desktop: three columns with equal flexible sides, so the navigation sits in
   * the true centre of the header. MobileMenu's wrappers use `display: contents`,
   * which makes the navigation and language switcher direct grid items.
   */
  @media (min-width: 64rem) {
    .site-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      column-gap: var(--space-lg);
      padding-block: clamp(1.25rem, 2.2vw, 2rem);
    }

    .site-header__brand {
      justify-self: start;
      width: clamp(8.5rem, 11.7vw, 12.25rem);
    }

    .site-header :global(.language-switcher) {
      justify-self: end;
    }
  }
</style>
