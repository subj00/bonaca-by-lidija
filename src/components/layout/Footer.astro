---
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/config/site';
import { getLocale } from '@/i18n/config';
import { useTranslations } from '@/i18n/dictionaries';
import { getSectionHref } from '@/i18n/routes';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const services = ['Professional make up', 'Lash & brow lift', 'Educations'];
const credit = { label: 'Dotmind', url: 'https://subj-portfolio.vercel.app/sr' };
const year = new Date().getFullYear();
---

<!--
  Solid Smoky Rose footer: centred white logo, the studio's services between two
  thin lines, copyright left and credit right.
-->
<footer class="site-footer">
  <div class="site-footer__main">
    <a class="site-footer__brand" href={getSectionHref('home', locale)}>
      <Logo variant="light" loading="lazy" sizes="(min-width: 64rem) 15rem, 11rem" />
    </a>

    <div class="site-footer__services">
      <span class="site-footer__line" aria-hidden="true"></span>
      <ul class="site-footer__service-list" role="list">
        {services.map((service) => <li class="site-footer__service">{service}</li>)}
      </ul>
      <span class="site-footer__line" aria-hidden="true"></span>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>© {year} {site.name}</p>
    <p>
      Design &amp; Development by{' '}
      <a
        class="site-footer__credit"
        href={credit.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${credit.label} (${t('a11y.newTab')})`}
      >
        {credit.label}
      </a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(3rem, 7vw, 4.5rem) var(--content-inset) 0;
    background-color: var(--color-smoky-rose);
    color: var(--color-linen);
  }

  /* Focus ring that stays visible on the dark background. */
  .site-footer :focus-visible {
    outline-color: var(--color-linen);
  }

  .site-footer__main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.75rem, 4vw, 2.5rem);
  }

  .site-footer__brand {
    display: block;
    width: clamp(10rem, 40vw, 11rem);
  }

  /* Services between two thin decorative lines: line | services | line. */
  .site-footer__services {
    display: grid;
    grid-template-columns: minmax(0.75rem, 1fr) auto minmax(0.75rem, 1fr);
    align-items: center;
    gap: clamp(0.625rem, 3vw, 2rem);
    width: 100%;
    max-width: 62rem;
  }

  .site-footer__line {
    border-block-start: 1px solid color-mix(in srgb, var(--color-linen) 45%, transparent);
  }

  /* Mobile: the three services stacked and centred. */
  .site-footer__service-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: 0;
  }

  .site-footer__service {
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.22em;
    padding-inline-start: 0.22em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
    padding-block: var(--space-md) var(--space-lg);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-align: center;
    color: color-mix(in srgb, var(--color-linen) 85%, transparent);
  }

  .site-footer__credit {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--color-linen) 45%, transparent);
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .site-footer__credit:hover {
    text-decoration-color: currentColor;
  }

  /* Tablet and up: services in one row, separated by thin vertical bars. */
  @media (min-width: 48rem) {
    .site-footer__service-list {
      flex-direction: row;
      gap: 0;
    }

    .site-footer__service + .site-footer__service::before {
      /* Visual separator only; hidden from assistive technology. */
      content: '|' / '';
      padding-inline: 1.25em;
      font-weight: 400;
      opacity: 0.6;
    }

    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: start;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__brand {
      width: clamp(12rem, 16vw, 15rem);
    }

    .site-footer__service {
      font-size: var(--text-xs);
    }
  }
</style>
