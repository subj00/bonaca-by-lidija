---
interface Props {
  /** Id of the heading, referenced by the section's `aria-labelledby`. */
  id: string;
  /** Optional small uppercase line under the heading; replaces the divider. */
  subtitle?: string;
}

const { id, subtitle } = Astro.props;
---

<!--
  Centered section heading, followed by either a subtle divider line
  (Reviews style) or a small subtitle (Contact style).
-->
<header class="section-title">
  <h2 class="section-title__text" id={id}><slot /></h2>
  {
    subtitle ? (
      <p class="section-title__subtitle">{subtitle}</p>
    ) : (
      <span class="section-divider section-title__rule" aria-hidden="true" />
    )
  }
</header>

<style>
  .section-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--color-ink);
  }

  /* Main section headings carry the brand's Smoky Rose (logo and navigation stay black). */
  .section-title__text {
    color: var(--color-smoky-rose);
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 7.2vw, 2.25rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0.16em;
    /* Balance the trailing letter-spacing so the text is optically centred. */
    padding-inline-start: 0.16em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* The line itself is the shared `.section-divider` (global.css); only spacing here. */
  .section-title__rule {
    margin-block-start: var(--space-lg);
  }

  .section-title__subtitle {
    margin-block-start: var(--space-sm);
    font-size: var(--text-xs);
    letter-spacing: 0.24em;
    padding-inline-start: 0.24em;
    text-transform: uppercase;
  }

  /* Desktop: compact, controlled title (36–42px). */
  @media (min-width: 64rem) {
    .section-title__text {
      font-size: clamp(2.25rem, 2.6vw, 2.625rem);
      letter-spacing: 0.14em;
      padding-inline-start: 0.14em;
    }

    .section-title__rule {
      margin-block-start: var(--space-md);
    }

    .section-title__subtitle {
      font-size: var(--text-sm);
    }
  }
</style>
