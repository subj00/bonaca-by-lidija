---
import { Image } from 'astro:assets';
import logo from '@/assets/logos/bonaca-logo.png';
import { site } from '@/config/site';

interface Props {
  /** Rendered width of the logo, as a CSS `sizes` value. */
  sizes: string;
  class?: string;
}

const { sizes, class: className } = Astro.props;

/*
 * The source file has a large transparent margin around the artwork.
 * The wrapper takes the aspect ratio of the visible artwork and the image is
 * offset so only the transparent margin is hidden. The file is not modified.
 * Values are measured from the 4000 × 2250 source: artwork 3662 × 1032 at (179, 683).
 */
const artwork = { x: 179, y: 683, width: 3662, height: 1032 };

const percent = (value: number) => `${(value * 100).toFixed(4)}%`;

const imageStyle = [
  `width: ${percent(logo.width / artwork.width)}`,
  `left: ${percent(-artwork.x / artwork.width)}`,
  `top: ${percent(-artwork.y / artwork.height)}`,
].join('; ');

// The image renders wider than the wrapper, so widen the `sizes` hint accordingly.
const imageSizes = `calc((${sizes}) * ${(logo.width / artwork.width).toFixed(3)})`;
---

<span class:list={['logo', className]} style={`--logo-ratio: ${artwork.width} / ${artwork.height}`}>
  <Image
    src={logo}
    alt={site.logoText}
    widths={[320, 640, 960, 1280, 1920]}
    sizes={imageSizes}
    loading="eager"
    style={imageStyle}
  />
</span>

<style>
  .logo {
    position: relative;
    display: block;
    aspect-ratio: var(--logo-ratio);
    overflow: hidden;
  }

  .logo img {
    position: absolute;
    max-width: none;
    height: auto;
  }
</style>
