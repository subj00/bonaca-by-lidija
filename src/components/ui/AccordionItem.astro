---
import ChevronDownIcon from '@/assets/icons/chevron-down.svg';

interface Props {
  /** Unique id on the page; the button and panel ids are derived from it. */
  id: string;
  title: string;
  /** Starts expanded. */
  open?: boolean;
  /** Level of the row heading, one below the heading it sits under. */
  headingLevel?: 3 | 4 | 5;
}

const { id, title, open = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const buttonId = `${id}-button`;
const panelId = `${id}-panel`;
---

<!--
  One accordion row with a thin border, shared by Services and Educations. The
  title is a button that shows or hides the slotted content (`aria-expanded` +
  `data-open`, animated); rows open and close independently.
  Without JavaScript the content is always shown.
-->
<div class="accordion__item">
  <Heading class="accordion__heading">
    <button
      class="accordion__trigger"
      id={buttonId}
      type="button"
      aria-expanded={open ? 'true' : 'false'}
      aria-controls={panelId}
      data-accordion-trigger
    >
      <span>{title}</span>
      <ChevronDownIcon class="accordion__chevron" aria-hidden="true" />
    </button>
  </Heading>
  <div
    class="accordion__panel"
    id={panelId}
    role="region"
    aria-labelledby={buttonId}
    data-open={open ? '' : undefined}
  >
    <div class="accordion__panel-inner">
      <div class="accordion__body">
        <slot />
      </div>
    </div>
  </div>
</div>

<script>
  /*
   * The open state lives on the button (`aria-expanded`) and on the panel
   * (`data-open`); CSS animates the change. Collapsed panels are `visibility:
   * hidden` once closed, so their text is skipped by keyboard and screen readers.
   */
  document.querySelectorAll<HTMLButtonElement>('[data-accordion-trigger]').forEach((trigger) => {
    if (trigger.dataset.accordionReady) return;
    trigger.dataset.accordionReady = 'true';

    const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
    if (!panel) return;
    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') !== 'true';
      trigger.setAttribute('aria-expanded', String(open));
      panel.toggleAttribute('data-open', open);
    });
  });
</script>

<style>
  /* Light outlines only: Linen throughout, framed by a soft Smoky Rose line. */
  .accordion__item {
    --accordion-duration: 320ms;
    --accordion-ease: cubic-bezier(0.45, 0, 0.25, 1);

    border: 1px solid color-mix(in srgb, var(--color-smoky-rose) 25%, transparent);
    background-color: var(--color-linen);
  }

  .accordion__heading {
    margin: 0;
    font: inherit;
  }

  .accordion__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-md);
    border: 0;
    /* Very light Taupe wash (15%) over the Linen row; text and borders stay at full strength. */
    background-color: color-mix(in srgb, var(--color-taupe) 15%, transparent);
    color: var(--color-smoky-rose);
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.16em;
    text-align: start;
    text-transform: uppercase;
    cursor: pointer;
  }

  .accordion__trigger:focus-visible {
    outline: 1px solid var(--color-smoky-rose);
    outline-offset: -4px;
  }

  .accordion__chevron {
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    transition: rotate var(--accordion-duration) var(--accordion-ease);
  }

  .accordion__trigger[aria-expanded='true'] .accordion__chevron {
    rotate: 180deg;
  }

  /*
   * Height animates through the grid row (0fr → 1fr), which works with any
   * amount of content, unlike `height: auto`. The content fades in alongside it.
   * When closing, `visibility` switches off only after the row has collapsed.
   */
  .accordion__panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows var(--accordion-duration) var(--accordion-ease),
      opacity calc(var(--accordion-duration) * 0.7) var(--accordion-ease),
      visibility 0s linear var(--accordion-duration);
  }

  .accordion__panel[data-open] {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition:
      grid-template-rows var(--accordion-duration) var(--accordion-ease),
      opacity var(--accordion-duration) var(--accordion-ease) calc(var(--accordion-duration) * 0.15),
      visibility 0s linear 0s;
  }

  .accordion__panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  /*
   * Content on the same Linen, divided from the header by a fainter hairline.
   * Padding and line sit inside the clipped area, so a closed row has no leftover
   * space or line, and nothing changes colour while it animates.
   */
  .accordion__body {
    padding: var(--space-sm) var(--space-md) var(--space-md);
    border-block-start: 1px solid color-mix(in srgb, var(--color-smoky-rose) 15%, transparent);
    background-color: var(--color-linen);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-ink);
  }

  /* Without JavaScript the rows cannot open, so all content is shown. */
  @media (scripting: none) {
    .accordion__panel {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
    }

    .accordion__chevron {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion__item {
      --accordion-duration: 0s;
    }
  }
</style>
